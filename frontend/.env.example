# Mẫu biến môi trường FRONTEND — chép thành `.env` (không commit .env) hoặc đặt trên dịch vụ hosting.
# Biến VITE_* được nhúng vào JS LÚC BUILD và lộ ra trình duyệt: không đặt secret ở đây.
# Đổi giá trị → phải build lại. Chi tiết: docs/HOSTING.md

# Gốc REST API, CÓ /api ở cuối.
# - Cùng tên miền với FE / chạy npm run dev hoặc preview (Vite proxy về localhost:3000): /api
# - BE ở tên miền riêng: https://api.example.com/api
VITE_API_BASE_URL=/api

# Gốc Socket.IO, KHÔNG có /api (client tự thêm /socket.io).
# - Cùng tên miền / dev / preview: /
# - BE ở tên miền riêng: https://api.example.com
VITE_SOCKET_URL=/

# Bật các tính năng cần API backend (CLAUDE.md Mục 15.22, 15.24) — để trống/false thì ẩn nút. Chỉ
# đặt 'true' khi backend đang chạy ĐÃ có route tương ứng (có từ nhánh feature/backend-ho-so-lich-su-push),
# không thì người dùng bấm vào chỉ nhận lỗi 404.
# - Sửa tên + đổi mật khẩu: PATCH /api/users/me, PATCH /api/users/me/password
VITE_BAT_SUA_HO_SO=true
# - Lịch sử SOS (trang /lich-su): GET /api/sos/mine/history
VITE_BAT_LICH_SU_SOS=true
# - Thông báo đẩy: GET /api/push/vapid-public-key, POST/DELETE /api/push/subscriptions — bật SAU khi
#   backend/.env có VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY (thiếu khoá thì nút bật báo lỗi).
VITE_BAT_THONG_BAO_DAY=false
