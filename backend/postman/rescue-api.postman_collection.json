    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const randomDigits = Math.floor(100000000 + Math.random() * 900000000).toString();",
                  "pm.collectionVariables.set('registerPhone', '0' + randomDigits);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('success = true', () => pm.expect(json.success).to.be.true);",
                  "pm.test('response contains accessToken and refreshToken', () => {",
                  "  pm.expect(json.data.accessToken).to.be.a('string');",
                  "  pm.expect(json.data.refreshToken).to.be.a('string');",
                  "});",
                  "pm.test('user object does not leak passwordHash', () => {",
                  "  pm.expect(json.data.user).to.not.have.property('passwordHash');",
                  "});",
                  "pm.test('registered phone matches request', () => {",
                  "  pm.expect(json.data.user.phone).to.eql(pm.collectionVariables.get('registerPhone'));",
                  "});",
                  "",
                  "pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "pm.collectionVariables.set('victimToken', json.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{registerPhone}}\",\n  \"name\": \"Postman Test User\",\n  \"password\": \"{{registerPassword}}\",\n  \"role\": \"victim\",\n  \"wardCode\": \"24781\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "2. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('success = true', () => pm.expect(json.success).to.be.true);",
                  "pm.test('response contains accessToken', () => {",
                  "  pm.expect(json.data.accessToken).to.be.a('string');",
                  "});",
                  "pm.test('logged-in phone matches request', () => {",
                  "  pm.expect(json.data.user.phone).to.eql(pm.collectionVariables.get('loginPhone'));",
                  "});",
                  "",
                  "pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "",
                  "const role = json.data.user.role;",
                  "if (role === 'victim') pm.collectionVariables.set('victimToken', json.data.accessToken);",
                  "if (role === 'rescuer') pm.collectionVariables.set('rescuerToken', json.data.accessToken);",
                  "if (role === 'commander') pm.collectionVariables.set('commanderToken', json.data.accessToken);"
                ]
              }
            }
          ],
