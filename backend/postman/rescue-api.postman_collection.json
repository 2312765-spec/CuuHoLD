                  "      pm.expect(team.eta_minutes).to.be.a('number');",
                  "    });",
                  "  });",
                  "  pm.test('results are sorted by distance ascending', () => {",
                  "    for (let i = 1; i < json.data.length; i++) {",
                  "      pm.expect(json.data[i].distance_meters).to.be.at.least(json.data[i - 1].distance_meters);",
                  "    }",
                  "  });",
                  "}"
