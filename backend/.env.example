NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_SMS_TYPE=2
ESMS_BRANDNAME=
RESCUE_CENTER_PHONE=

# OpenRouteService (https://openrouteservice.org/dev/#/signup, free tier) — dẫn đường thật
# cho RescuerView, không phụ thuộc Google Maps. Để trống thì API /api/routing/route trả 503,
# frontend tự lùi về đường chim bay, không ảnh hưởng phần còn lại của app.
ORS_API_KEY=

# Web Push — thông báo đẩy (F-PWA-05). Tạo cặp khoá 1 lần: npx web-push generate-vapid-keys
# Để trống thì tắt thông báo đẩy (GET /api/push/vapid-public-key trả 503), phần khác chạy bình thường.
# Frontend bật nút tương ứng bằng VITE_BAT_THONG_BAO_DAY=true (frontend/.env).
# ⛔ VAPID_PRIVATE_KEY là secret — không commit, không đưa lên frontend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
