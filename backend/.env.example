NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
# Số tầng proxy đứng trước backend. Máy dev: 0 (hoặc xoá hẳn dòng, KHÔNG để trống). Render: 1 — thiếu thì mọi người
# dùng chung 1 IP sau proxy, rate limit đăng nhập (5/15 phút) chặn cả tỉnh. Xem docs/HOSTING.md.
TRUST_PROXY_HOPS=0
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_SMS_TYPE=2
ESMS_BRANDNAME=
# Chạy thử: true = KHÔNG gửi SMS thật khi tạo SOS (mỗi tin tốn tiền eSMS), chỉ ghi log mã SOS.
# Để true khi dev/test/demo; đặt false (hoặc bỏ trống) ở môi trường dùng thật. Chỉ nhận true/false.
SMS_DRY_RUN=true
RESCUE_CENTER_PHONE=

# OpenRouteService (https://openrouteservice.org/dev/#/signup, free tier) — dẫn đường thật
# cho RescuerView, không phụ thuộc Google Maps. Để trống thì API /api/routing/route trả 503,
# frontend tự lùi về đường chim bay, không ảnh hưởng phần còn lại của app.
ORS_API_KEY=

# Proxy tile (GET /api/tiles/..., docs/tile-proxy-plan.md) — User-Agent gửi lên openstreetmap.fr.
# Chính sách tile của OSM yêu cầu nhận diện được ứng dụng + cách liên hệ. Để trống = chuỗi chung chung.
# VD: TILE_PROXY_USER_AGENT=ten-ung-dung/1.0 (mailto:email-nhom@example.com)
TILE_PROXY_USER_AGENT=

# Web Push — thông báo đẩy (F-PWA-05). Tạo cặp khoá 1 lần: npx web-push generate-vapid-keys
# Để trống thì tắt thông báo đẩy (GET /api/push/vapid-public-key trả 503), phần khác chạy bình thường.
# Frontend bật nút tương ứng bằng VITE_BAT_THONG_BAO_DAY=true (frontend/.env).
# ⛔ VAPID_PRIVATE_KEY là secret — không commit, không đưa lên frontend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
